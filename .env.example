# Copy thành .env.local rồi điền. .env.local KHÔNG commit.
# Supabase Dashboard → Project Settings → API

# Dùng ở app (được phép lộ ra client)
NEXT_PUBLIC_SUPABASE_URL=https://<project-id>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# CHỈ dùng cho scripts/ chạy local (import:books). Không bao giờ import vào src/.
# Secret key mới (sb_secret_...) hoặc service_role key cũ đều được.
SUPABASE_SERVICE_ROLE_KEY=

# Tùy chọn: có key thì quota Google Books cao hơn
GOOGLE_BOOKS_API_KEY=

# ---- Tùy chọn (Phase 9–10). Thiếu thì app vẫn chạy. Chỉ ở server: KHÔNG thêm NEXT_PUBLIC_. ----

# URL gốc cho link trong email / sitemap. Trên Vercel có thể bỏ (dùng VERCEL_PROJECT_PRODUCTION_URL).
SITE_URL=

# Email đơn hàng qua Resend (resend.com). Thiếu một trong hai → chỉ ghi log, không gửi.
RESEND_API_KEY=
EMAIL_FROM=

# Tài khoản nhận chuyển khoản VietQR. Thiếu biến nào → thông tin DEMO + cảnh báo "đừng chuyển tiền".
# BIN: mã ngân hàng 6 số của NAPAS (VD Vietcombank 970436, MB 970422).
VIETQR_BANK_BIN=
VIETQR_BANK_NAME=
VIETQR_ACCOUNT_NO=
VIETQR_ACCOUNT_NAME=
